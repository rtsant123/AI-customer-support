# Database (Railway Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aicaller

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+918XXXXXXXXX
BACKEND_URL=https://your-app.railway.app

# Sarvam AI (STT)
SARVAM_API_KEY=your-key

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your-key

# Anthropic
ANTHROPIC_API_KEY=your-key

# Razorpay
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-secret

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET_NAME=call-recordings
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Redis
REDIS_URL=redis://localhost:6379

# App
SECRET_KEY=generate-a-long-random-secret-here
FRONTEND_URL=http://localhost:3000
RATE_PER_MIN_PAISE=1200
